# NVIDIA NIM API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/world_cup_autoposter
# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./world_cup_autoposter.db

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Meta/Facebook Graph API
META_ACCESS_TOKEN=your_meta_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# Pexels API (for stock footage)
PEXELS_API_KEY=your_pexels_api_key

# Pixabay API
PIXABAY_API_KEY=your_pixabay_api_key

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# WhatsApp Notification Settings (OpenWA)
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER=+1234567890  # Your WhatsApp number to receive notifications
WHATSAPP_SESSION_FILE=whatsapp_session.json

# Buffer API (for real social media publishing)
BUFFER_API_KEY=  # Get from https://buffer.com/developers

# Scraping Configuration
COMPETITOR_ACCOUNTS=['433', 'espnfc', 'championsleague', 'fifaworldcup', 'skysportsfootball']
SCRAPE_INTERVAL_HOURS=6

# Video Generation Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_SECONDS=30

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0